{
    // Build-only tsconfig for ng-packagr. The admin app compiles these same
    // sources through ITS tsconfig (source consumption via a path mapping), so
    // this file exists purely to produce a distributable.
    //
    // No `extends`: the package has no toolchain of its own, and its
    // `node_modules` is a relative symlink to the admin's so exactly one
    // @angular tree is in play.
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "dom"],
        "strict": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": false,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "declaration": true,
        "sourceMap": true,
        "paths": {
            // Peers, as BUILT output rather than sources: compiling a peer's
            // sources into this bundle would ship a second copy of it to any
            // application that installs both. Build them first, in their own
            // checkouts.
            "@coolms/core-angular": ["../core-angular/dist"],
            "@coolms/ui-angular": ["../ui-angular/dist"],
            "@coolms/editor-angular": ["../editor-angular/dist"],
            "@coolms/pdf-angular": ["../pdf-angular/dist"]
        }
    },
    "angularCompilerOptions": {
        "compilationMode": "partial",
        "strictInjectionParameters": true,
        "strictTemplates": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts"]
}
